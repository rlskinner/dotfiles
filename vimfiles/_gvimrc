" GVim configuration
"   Robert Skinner

set guioptions+=t   " tear off menus

set lines=69        " ? Can we compute this based on font and resolution?

set visualbell      " Use a visual bell instead of beeping.

" Set guifont
" Windows 2000 sets OSTYPE? -- if $OSTYPE == "posix" && $OS == "Windows_NT"
if $OS == "Windows_NT"
    " echo "windows"
    set guifont=Consolas:h11:cANSI:qDRAFT
	source $NET_HOME/dotfiles/vimfiles/colors/myWinBlue.vim	" remove 'bold' for crappy Windows fonts
elseif $OSTYPE == "linux"
    " echo "linux"
    set guifont=-schumacher-clean-bold-r-normal-*-*-140-*-*-c-*-iso646.1991-irv
    " ugh! now we have to deal with this!
    set guifontset=
elseif $OSTYPE == "irix"
    " echo "irix"
    " for 1280x1024
    set guifont=-misc-fixed-bold-r-normal--13-120-75-75-c-80-iso8859-1 
else
    echo "unable to set guifont for unknown OS"
endif
" set guifont=-misc-fixed-bold-r-normal--15-140-75-75-c-90-iso8859-1 " for 1600x1280
" set guifont=-misc-fixed-bold-r-normal--13-100-100-100-c-80-iso8859-1 " for 1280x1024

