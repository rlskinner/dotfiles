" Make any OpenGL constant highlight like a regular constant
" Keeping track of new extension constants is a near-futile 
" exercise, of course.  Use this command (in sh):
"
"    perl -n -e \
"    'if( $_ =~ /^#\s*define/ ) { 
"	split / /; 
"	print "syntax keyword OpenGLConstant\t$_[1]\n" 
"	    unless ( $_[1] =~ /[a-z]/ );
"    }' /usr/include/GL/gl.h | sort
"
