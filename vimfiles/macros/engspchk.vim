syn case match

" ignores people's middle-name initials
syn match   GoodWord	"\<[A-Z]\."

" Highlight the BadWords
hi link BadWord	Error

" Support for moving to next/previous spelling error
map \en	:call Spchknxt()<CR>
map \ep	:call Spchkprv()<CR>

function! Spchknxt()
  let errid=synIDtrans(hlID("Error"))
  let lastline=line("$")
  
  if synIDtrans(synID(line("."),col("."),1)) == errid
    norm w
  endif
  
  " skip words until we find next error
  while line(".") <= lastline
    norm w
    if synIDtrans(synID(line("."),col("."),1)) == errid
      break
    endif
  endwhile
  unlet errid
  unlet lastline
endfunction

function! Spchkprv()
  let errid=synIDtrans(hlID("Error"))
  
  if synIDtrans(synID(line("."),col("."),1)) == errid
    norm b
  endif
  
  " skip words until we find next error
  while line(".") >= 1
    norm b
    if synIDtrans(synID(line("."),col("."),1)) == errid
      break
    endif
  endwhile
  unlet errid
endfunction

