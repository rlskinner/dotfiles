" Vim syntax file
" Language   : English
" Maintainer : Dr. Charles E. Campbell, Jr. <Charles.Campbell@gsfc.nasa.gov>
" Last Change: June 14, 1999
" Version    : 1.08a
"
" This file contains four maps, too:
"  \et : add  word under cursor into database (temporarily - ie. just this file)
"  \es : save word under cursor into database (permanently)
"        Requires CVIMSYN to be an exported environment variable pointing to
"        directory holding database: $CVIMSYN/usr_spchk.vim
"  \en : move cursor to next spelling error
"  \ep : move cursor to previous spelling error (assuming you left it in place)
"------------------------------------------------------------------------------

" Maps to facilitate entering new words
"  use  temporarily (\et)
"  save permanently (\es)
map \et	:syn case ignore<CR>:exe "syn keyword GoodWord " . expand("<cword>")<CR>:syn case match<CR>
if version >= 504
 map \es	:syn case ignore<CR>:exe "syn keyword GoodWord " . expand("<cword>")<CR>:syn case match<CR>:let @_=system('echo "syn keyword GoodWord ' . expand("<cword>") . '" >> $CVIMSYN/usr_spchk.vim')<CR>
else
 map \es	:syn case ignore<CR>:exe "syn keyword GoodWord " . expand("<cword>")<CR>:syn case match<CR>:!echo "syn keyword GoodWord <cword>" >> $CVIMSYN/usr_spchk.vim<CR>
endif

